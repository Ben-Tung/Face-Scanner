# docker-compose settings. Copy to .env to override; every value has a default,
# so compose works with no .env at all. Never commit a real .env.

POSTGRES_USER=palette
POSTGRES_PASSWORD=palette
POSTGRES_DB=palette
POSTGRES_PORT=5432

BACKEND_PORT=8000
FRONTEND_PORT=3000

# Stripe secrets, passed through to the backend container. Leave unset until
# Stripe Checkout is configured. Get STRIPE_WEBHOOK_SECRET from `stripe
# listen` (local dev) or the Stripe Dashboard's webhook page (deployed).
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
