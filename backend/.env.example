# Backend environment variables. Copy to .env for local (non-Docker) runs;
# docker-compose supplies these directly. Never commit a real .env.

ENVIRONMENT=development
# Accepts a JSON array (e.g. ["https://a.com","https://b.com"]) or a
# comma-separated list (e.g. https://a.com,https://b.com).
CORS_ORIGINS=["http://localhost:3000"]
DATABASE_URL=postgresql://palette:palette@localhost:5432/palette

# Per-IP rate limits for POST /api/scan and /api/scan/manual (each hits a
# billed Anthropic call + MediaPipe pipeline). Safe to leave at defaults.
# SCAN_RATE_LIMIT_PER_MINUTE=5
# SCAN_RATE_LIMIT_PER_DAY=60

# See app/client_ip.py — only flip if Render's X-Forwarded-For behavior is
# empirically confirmed to put the real client IP on the left instead of
# the right (default false = trust rightmost).
# CLIENT_IP_TRUST_LEFTMOST=false

# Secrets — leave unset until the features that need them exist.
# ANTHROPIC_API_KEY=
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# RESEND_API_KEY=

# Where the Next.js frontend is served — used to build Stripe Checkout
# success_url/cancel_url. Safe to leave at the local default.
FRONTEND_BASE_URL=http://localhost:3000
